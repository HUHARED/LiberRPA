{
  "name": "liberrpa-snippets-tree",
  "displayName": "LiberRPA Snippets Tree",
  "description": "This extension is part of LiberRPA to insert Python snippets.",
  "version": "0.3.0",
  "publisher": "LiberRPA",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Snippets"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liberrpa_view_container",
          "title": "LiberRPA",
          "icon": "./assets/LiberRPA_icon_v3_monochrome_24.svg"
        }
      ]
    },
    "views": {
      "liberrpa_view_container": [
        {
          "type": "tree",
          "id": "LiberRPA.snippetsTreeView",
          "name": "Snippets Tree",
          "icon": "./assets/LiberRPA_icon_v3_monochrome_24.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "LiberRPA.snippetsTree.navigateSnippetTab",
        "title": "Navigate Python Snippet Field",
        "category": "LiberRPA",
        "enablement": "editorTextFocus && editorLangId == python && inSnippetMode && hasNextTabstop && !editorReadonly && !editorTabMovesFocus && !inSnippetChoice && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible"
      },
      {
        "command": "LiberRPA.snippetsTree.pastePythonWithManagedImports",
        "title": "Paste Python and Update Managed Imports",
        "category": "LiberRPA",
        "enablement": "editorTextFocus && editorLangId == python && !editorReadonly"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "LiberRPA.snippetsTree.navigateSnippetTab",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "key": "tab",
        "command": "LiberRPA.snippetsTree.navigateSnippetTab",
        "when": "editorTextFocus && editorLangId == python && inSnippetMode && hasNextTabstop && !editorReadonly && !editorTabMovesFocus && !inSnippetChoice && !editorHasSelection && !editorHasMultipleSelections && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible"
      },
      {
        "key": "ctrl+v",
        "command": "LiberRPA.snippetsTree.pastePythonWithManagedImports",
        "when": "editorTextFocus && editorLangId == python && !editorReadonly"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/snippets_favorite.jsonc",
        "url": "./assets/favoriteSnippets.schema.json"
      }
    ]
  },
  "icon": "./assets/LiberRPA_icon_v3_color_SnippetsTree_128.png",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/HUHARED/LiberRPA/blob/main/vscodeExtensions/liberrpa-snippets-tree/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/HUHARED/LiberRPA.git",
    "directory": "vscodeExtensions/liberrpa-snippets-tree"
  },
  "vsce": {
    "baseContentUrl": "https://github.com/HUHARED/LiberRPA/blob/main/vscodeExtensions/liberrpa-snippets-tree",
    "baseImagesUrl": "https://raw.githubusercontent.com/HUHARED/LiberRPA/main/vscodeExtensions/liberrpa-snippets-tree"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "package:vsix": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.121.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.6.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
