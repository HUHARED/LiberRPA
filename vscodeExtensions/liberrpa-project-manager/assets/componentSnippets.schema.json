    "snippetKey": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*_[^.\\s]+\\.[^.\\s]+$",
      "markdownDescription": "Stable Component Snippet key in the form `PackageName_ModuleName.snippet_name`. The Project Manager also checks the current package name, Python identifiers, and public Module existence."
    },
    "snippetBody": {
      "markdownDescription": "Snippet body. A string represents one line; an array represents multiple lines. VS Code Snippet placeholders such as `${1:value}`, `${1|one,two|}`, and `$0` are supported. For `line` insertion, Project Manager appends `$0` when needed.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "contains": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      ],
      "defaultSnippets": [
        {
          "label": "Single-line body",
          "body": "${1:Component_Module.function_name()}"
        },
        {
          "label": "Multi-line body",
          "body": [
            "${1:strResult} = Component_Module.function_name()",
            "${2:Log.info(strResult)}"
          ]
        }
      ]
    },
    "insertionMode": {
      "type": "string",
      "enum": ["line", "cursor"],
      "markdownEnumDescriptions": [
        "Insert one or more statements at the current line. Project Manager appends a final `$0` tab stop when needed.",
        "Insert at the current cursor position or replace the current selection. No final `$0` is added automatically."
      ],
      "default": "line",
      "markdownDescription": "Controls how LiberRPA Snippets Tree inserts the Snippet."
    },
    "liberrpaImportList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "Log",
          "delay",
          "get_component_resource_path",
          "Mouse",
          "Keyboard",
          "Window",
          "UiInterface",
          "Browser",
          "Excel",
          "Outlook",
          "Application",
          "Database",
          "Data",
          "Str",
          "List",
          "Dict",
          "Regex",
          "Math",
          "Time",
          "File",
          "OCR",
          "Web",
          "Mail",
          "FTP",
          "Clipboard",
          "System",
          "Credential",
          "ScreenPrint",
          "Dialog",
          "Trigger",
          "DatabaseConnection",
          "PrjArgs",
          "CustomArgs",
          "SelectorWindow",
          "SelectorUia",
          "SelectorHtml",
          "SelectorImage",
          "Selector"
        ]
      },
      "markdownDescription": "Additional names imported from `liberrpa.Modules`. Completion includes all names available to Component Snippets in their managed-import order."
    },
    "genericImportList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^.\\s]+$"
      },
      "markdownDescription": "Names imported from this source. For the current Component package, use public top-level Module names."
    },
    "imports": {
      "type": "object",
      "markdownDescription": "Additional managed imports required by this Snippet. The owning public Component Module is added automatically and does not need to be listed. Static completion is provided for `liberrpa.Modules`.",
      "properties": {
        "liberrpa.Modules": {
          "$ref": "#/definitions/liberrpaImportList"
        }
      },
      "propertyNames": {
        "anyOf": [
          {
            "const": "liberrpa.Modules"
          },
          {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        ]
      },
      "additionalProperties": {
        "$ref": "#/definitions/genericImportList"
      },
      "defaultSnippets": [
        {
          "label": "Import from liberrpa.Modules",
          "body": {
            "liberrpa.Modules": [
              "${1|Log,delay,get_component_resource_path,Mouse,Keyboard,Window,UiInterface,Browser,Excel,Outlook,Application,Database,Data,Str,List,Dict,Regex,Math,Time,File,OCR,Web,Mail,FTP,Clipboard,System,Credential,ScreenPrint,Dialog,Trigger,DatabaseConnection,PrjArgs,CustomArgs|}"
            ]
          }
        }
      ]
    },
    "astSnippetOverride": {
      "type": "object",
      "additionalProperties": false,
      "markdownDescription": "Optional changes to an AST-generated Snippet. Its stable key, prefix, category, and mandatory owning-Module import remain controlled by Project Manager.",
      "properties": {
        "label": {
          "type": "string",
          "pattern": "^(?=[^\\r\\n]*\\S)[^\\r\\n]*$",
          "markdownDescription": "Replacement label shown inside the Snippet category."
        },
        "body": {
          "$ref": "#/definitions/snippetBody"
        },
        "description": {
          "type": "string",
          "pattern": "\\S",
          "markdownDescription": "Replacement description shown in completion details and hover information."
        },
        "insertionMode": {
          "$ref": "#/definitions/insertionMode"
        },
        "imports": {
          "$ref": "#/definitions/imports"
        }
      },
      "defaultSnippets": [
        {
          "label": "Override description",
          "body": {
            "description": "${1:Describe the customized Snippet.}"
          }
        },
        {
          "label": "Override selected fields",
          "body": {
            "label": "${1:label}",
            "body": ["${2:Component_Module.function_name()}"],
            "description": "${3:Describe the customized Snippet.}",
            "insertionMode": "${4|line,cursor|}",
            "imports": {}
          }
        }
      ]
    },
    "handWrittenSnippet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "description"],
      "markdownDescription": "A hand-written Component Snippet. Its stable key determines the category and owning public Component Module import.",
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^(?=[^\\r\\n]*\\S)[^\\r\\n]*$",
          "markdownDescription": "Text used to match this Snippet in IntelliSense. Defaults to the stable Snippet key."
        },
        "label": {
          "type": "string",
          "pattern": "^(?=[^\\r\\n]*\\S)[^\\r\\n]*$",
          "markdownDescription": "Label shown inside the category. Defaults to the `snippet_name` part of the stable key."
        },
        "body": {
          "$ref": "#/definitions/snippetBody"
        },
        "description": {
          "type": "string",
          "pattern": "\\S",
          "markdownDescription": "Required user-facing description shown in completion details and hover information."
        },
        "insertionMode": {
          "$ref": "#/definitions/insertionMode"
        },
        "imports": {
          "$ref": "#/definitions/imports"
        }
      },
      "defaultSnippets": [
        {
          "label": "New hand-written Component Snippet",
          "body": {
            "body": ["${1:Component_Module.function_name()}"],
            "description": "${2:Describe this Snippet.}",
            "insertionMode": "${3|line,cursor|}",
            "imports": {}
          }
        }
      ]
    }
  }
}
