{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "The productIconId enum is a snapshot of the Codicon identifiers listed in the VS Code Product Icon Reference on September 2, 2026. Keep the snapshot date and documentation synchronized when updating it.",
  "$id": "https://raw.githubusercontent.com/HUHARED/LiberRPA/main/vscodeExtensions/liberrpa-project-manager/assets/componentSnippets.schema.json",
  "title": "LiberRPA Component Snippet Configuration",
  "description": "Configuration merged with AST-generated Snippets when publishing a LiberRPA Component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "categoryIcons",
    "excludedAstSnippets",
    "astSnippetOverrides",
    "snippets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "markdownDescription": "Component Snippet configuration schema version. The current and only supported value is `1`."
    },
    "categoryIcons": {
      "type": "object",
      "markdownDescription": "Maps public Component Module names to VS Code Product Icon IDs. Modules omitted here use `library`. Value completion includes a bundled snapshot of the Codicon identifiers documented for VS Code extensions.",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^.\\s]+$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/productIconId"
      },
      "defaultSnippets": [
        {
          "label": "Assign a category icon",
          "body": {
            "${1:ModuleName}": "${2:library}"
          }
        }
      ]
    },
    "excludedAstSnippets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/snippetKey"
      },
      "markdownDescription": "AST-generated Snippet keys to omit from the final catalog. Copy stable keys from `_Snippets/ast.snippets.json`."
    },
    "astSnippetOverrides": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/snippetKey"
      },
      "additionalProperties": {
        "$ref": "#/definitions/astSnippetOverride"
      },
      "markdownDescription": "Changes to existing AST-generated Snippets. Keys must exist in the latest `_Snippets/ast.snippets.json`.",
      "defaultSnippets": [
        {
          "label": "Override an AST-generated Snippet",
          "body": {
            "${1:PackageName_ModuleName.function_name}": {
              "description": "${2:Describe the customized Snippet.}"
            }
          }
        }
      ]
    },
    "snippets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/snippetKey"
      },
      "additionalProperties": {
        "$ref": "#/definitions/handWrittenSnippet"
      },
      "markdownDescription": "Additional hand-written Component Snippets. Stable keys use `PackageName_ModuleName.snippet_name`.",
      "defaultSnippets": [
        {
          "label": "Add a hand-written Component Snippet",
          "body": {
            "${1:PackageName_ModuleName.snippet_name}": {
              "body": ["${2:Component_Module.function_name()}"],
              "description": "${3:Describe this Snippet.}",
              "insertionMode": "${4|line,cursor|}",
              "imports": {}
            }
          }
        }
      ]
    }
  },
  "defaultSnippets": [
    {
      "label": "LiberRPA Component Snippet configuration",
      "description": "Create the complete configuration structure.",
      "body": {
        "schemaVersion": 1,
        "categoryIcons": {},
        "excludedAstSnippets": [],
        "astSnippetOverrides": {},
        "snippets": {}
      }
    }
  ],
