{
  "name": "liberrpa-project-manager",
  "displayName": "LiberRPA Project Manager",
  "description": "This extension is part of LiberRPA to manage project.",
  "version": "0.3.0",
  "publisher": "LiberRPA",
  "engines": {
    "vscode": "^1.121.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "LiberRPA.createProject",
        "category": "LiberRPA",
        "title": "Create a New Project"
      },
      {
        "command": "LiberRPA.packageProject",
        "category": "LiberRPA",
        "title": "Package Project",
        "enablement": "liberrpaProjectManager.projectType == flow"
      },
      {
        "command": "LiberRPA.publishComponent",
        "category": "LiberRPA",
        "title": "Publish Component",
        "enablement": "liberrpaProjectManager.projectType == component"
      },
      {
        "command": "LiberRPA.manageComponents",
        "category": "LiberRPA",
        "title": "Manage Components",
        "enablement": "liberrpaProjectManager.projectType == flow || liberrpaProjectManager.projectType == component"
      },
      {
        "command": "LiberRPA.importComponentWheels",
        "category": "LiberRPA",
        "title": "Import Component Wheels"
      },
      {
        "command": "LiberRPA.rebuildComponentRepositoryIndex",
        "category": "LiberRPA",
        "title": "Rebuild Component Repository Index"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "**/_Snippets/snippets.jsonc",
        "url": "./assets/componentSnippets.schema.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "LiberRPA.packageProject",
          "when": "liberrpaProjectManager.projectType == flow"
        },
        {
          "command": "LiberRPA.publishComponent",
          "when": "liberrpaProjectManager.projectType == component"
        },
        {
          "command": "LiberRPA.manageComponents",
          "when": "liberrpaProjectManager.projectType == flow || liberrpaProjectManager.projectType == component"
        }
      ]
    }
  },
  "icon": "./assets/LiberRPA_icon_v3_color_ProjectManager_128.png",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/HUHARED/LiberRPA/blob/main/vscodeExtensions/liberrpa-project-manager/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/HUHARED/LiberRPA.git",
    "directory": "vscodeExtensions/liberrpa-project-manager"
  },
  "vsce": {
    "baseContentUrl": "https://github.com/HUHARED/LiberRPA/blob/main/vscodeExtensions/liberrpa-project-manager",
    "baseImagesUrl": "https://raw.githubusercontent.com/HUHARED/LiberRPA/main/vscodeExtensions/liberrpa-project-manager"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check:synchronized-files && npm run compile:webview && npm run compile:extension",
    "compile:webview": "npm --prefix webview-ui run build",
    "watch": "webpack --watch",
    "package": "npm run check:synchronized-files && npm run compile:webview && webpack --mode production --devtool hidden-source-map",
    "package:vsix": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src && npm --prefix webview-ui run lint",
    "test": "vscode-test",
    "compile:extension": "webpack",
    "check:synchronized-files": "node scripts/checkSynchronizedFiles.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.121.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.6.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "archiver": "^8.0.0"
  }
}
