{
  "Project Values": {
    "PrjArgs.elapsedTime": {
      "prefix": "PrjArgs.elapsedTime",
      "body": [
        "PrjArgs.elapsedTime"
      ],
      "description": "Get elapsed seconds since the current RPA project started.",
      "imports": {
        "liberrpa.Modules": [
          "PrjArgs"
        ]
      },
      "appendFinalTabstop": false,
      "insertionMode": "cursor"
    },
    "PrjArgs.errorObj": {
      "prefix": "PrjArgs.errorObj",
      "body": [
        "PrjArgs.errorObj"
      ],
      "description": "Get the current flow error object, or None if no error is being handled.",
      "imports": {
        "liberrpa.Modules": [
          "PrjArgs"
        ]
      },
      "appendFinalTabstop": false,
      "insertionMode": "cursor"
    },
    "PrjArgs.projectPath": {
      "prefix": "PrjArgs.projectPath",
      "body": [
        "PrjArgs.projectPath"
      ],
      "description": "Get the absolute path of the current RPA project.",
      "imports": {
        "liberrpa.Modules": [
          "PrjArgs"
        ]
      },
      "appendFinalTabstop": false,
      "insertionMode": "cursor"
    }
  },
  "Basic": {
    "Basic.delay": {
      "prefix": "delay",
      "body": [
        "delay(${1:1000})"
      ],
      "description": "Wait for a specified time, in milliseconds.",
      "imports": {
        "liberrpa.Modules": [
          "delay"
        ]
      }
    },
    "Basic.new python file": {
      "prefix": "new",
      "body": [
        "# FileName: $TM_FILENAME",
        "# <LiberRPA imports: managed>",
        "# This block is managed by LiberRPA. Do not edit it manually.",
        "# </LiberRPA imports: managed>",
        "",
        "",
        "def main() -> None:",
        "\traise NotImplementedError()",
        "",
        "",
        "if __name__ == \"__main__\":",
        "\tmain()",
        ""
      ],
      "description": "Create a basic LiberRPA Python file template with a managed import block, main(), and a direct-run entry point."
    },
    "Basic.def a function": {
      "prefix": "def",
      "body": [
        "def ${1:function_name}($2) -> ${3:None}:",
        "\t$4"
      ],
      "description": "Define a function with parameters and a return annotation."
    },
    "Basic.if __main__": {
      "prefix": "main",
      "body": [
        "if __name__ == \"__main__\":",
        "\t$1"
      ],
      "description": "Run code only when the file is executed directly."
    },
    "Basic.File Header": {
      "prefix": "header",
      "body": [
        "# FileName: $TM_FILENAME"
      ],
      "description": "Insert a file name comment."
    },
    "Basic.# type: ignore": {
      "prefix": "ignore",
      "body": [
        " # type: ignore - ${1:Reason}"
      ],
      "description": "Add a # type: ignore comment at the end of the current line to suppress a type checker warning, with a reason."
    }
  },
  "LogicControl": {
    "LogicControl.if": {
      "prefix": "if",
      "body": [
        "if ${1:condition}:",
        "\t$2"
      ],
      "description": "Run a block only when a condition is true."
    },
    "LogicControl.else": {
      "prefix": "else",
      "body": [
        "else:",
        "\t$1"
      ],
      "description": "Run a block when the previous if/elif conditions are false."
    },
    "LogicControl.elif": {
      "prefix": "elif",
      "body": [
        "elif ${1:condition}:",
        "\t$2"
      ],
      "description": "Add another condition after an if block."
    },
    "LogicControl.match case": {
      "prefix": "match case",
      "body": [
        "match ${1:variableName}:",
        "\tcase ${2:value}:",
        "\t\traise NotImplementedError('TODO')",
        "\tcase _:",
        "\t\traise NotImplementedError('TODO')"
      ],
      "description": "Use Python structural pattern matching to choose a branch by value or pattern."
    },
    "LogicControl.case": {
      "prefix": "case",
      "body": [
        "case ${1:value}:",
        "\traise NotImplementedError('TODO')"
      ],
      "description": "Add a case branch inside a match block."
    },
    "LogicControl.for-index, item": {
      "prefix": "for",
      "body": [
        "for ${1:idx}, ${2:item} in enumerate(${3:obj},start=${4:0}):",
        "\t$5"
      ],
      "description": "Loop over items with enumerate() and a zero-based or custom starting index."
    },
    "LogicControl.for-item": {
      "prefix": "for",
      "body": [
        "for ${1:item} in ${2:obj}:",
        "\t$3"
      ],
      "description": "Loop over each item in an iterable object."
    },
    "LogicControl.for-counting cycle": {
      "prefix": "for",
      "body": [
        "for ${1:idx} in range(${2:0},${3:intStop},${4:1}):",
        "\t$5"
      ],
      "description": "Loop over a sequence of numbers generated by range()."
    },
    "LogicControl.while": {
      "prefix": "while",
      "body": [
        "while ${1:condition}:",
        "\t$2"
      ],
      "description": "Repeat a block while a condition is true."
    },
    "LogicControl.continue": {
      "prefix": "continue",
      "body": [
        "continue"
      ],
      "description": "Skip the rest of the current loop iteration and continue with the next one."
    },
    "LogicControl.break": {
      "prefix": "break",
      "body": [
        "break"
      ],
      "description": "Exit the nearest loop immediately."
    },
    "LogicControl.try catch": {
      "prefix": "try",
      "body": [
        "try:",
        "\t$1",
        "except Exception as e:",
        "\traise NotImplementedError('TODO')",
        "else:",
        "\traise NotImplementedError('TODO')",
        "finally:",
        "\traise NotImplementedError('TODO')"
      ],
      "description": "Handle exceptions with try/except, and optionally run else/finally blocks."
    },
    "LogicControl.retry": {
      "prefix": "retry",
      "body": [
        "intMaxTryCount = ${1:intMaxTryCount}",
        "for intTryIdx in range(intMaxTryCount):",
        "\ttry:",
        "\t\t$2",
        "\texcept Exception as e:",
        "\t\tLog.exception_info(e)",
        "\t\tif intTryIdx +1 == intMaxTryCount:",
        "\t\t\traise e",
        "\telse:",
        "\t\tbreak"
      ],
      "description": "Retry a block until it succeeds, or raise the last error after the maximum try count is reached.",
      "imports": {
        "liberrpa.Modules": [
          "Log"
        ]
      }
    },
    "LogicControl.raise an exception": {
      "prefix": "raise",
      "body": [
        "raise ${1:Exception}(${2:\"The description of the error\"})"
      ],
      "description": "Raise an exception with a message."
    },
    "LogicControl.return": {
      "prefix": "return",
      "body": [
        "return ${1:value}"
      ],
      "description": "Return a value from the current function."
    }
  }
}