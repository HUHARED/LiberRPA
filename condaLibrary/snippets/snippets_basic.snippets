{
  // These snippets cannot be generated automatically. This is not the final snippet file; the final snippet file should not use nested dictionaries.
  "Basic": {
    "Basic.delay": {
      "prefix": "delay",
      "body": [
        "delay(${1:1000})"
      ],
      "description": "Wait for a specified time, in milliseconds."
    },
    "Basic.new python file": {
      "prefix": "new",
      "body": [
        "# FileName: $TM_FILENAME",
        "# <LiberRPA imports: managed>",
        "# This block is managed by LiberRPA. Do not edit it manually.",
        "# </LiberRPA imports: managed>",
        "",
        "",
        "def main() -> None:",
        "\traise NotImplementedError()",
        "",
        "",
        "if __name__ == \"__main__\":",
        "\tmain()",
        ""
      ],
      "description": "Create a basic LiberRPA Python file template with a managed import block, main(), and a direct-run entry point."
    },
    "Basic.def a function": {
      "prefix": "def",
      "body": [
        "def ${1:function_name}($2) -> ${3:None}:",
        "\t$4"
      ],
      "description": "Define a function with parameters and a return annotation."
    },
    "Basic.if __main__": {
      "prefix": "main",
      "body": [
        "if __name__ == \"__main__\":",
        "\t$1"
      ],
      "description": "Run code only when the file is executed directly."
    },
    "Basic.File Header": {
      "prefix": "header",
      "body": [
        "# FileName: $TM_FILENAME"
      ],
      "description": "Insert a file name comment."
    },
    "Basic.# type: ignore": {
      "prefix": "ignore",
      "body": [
        " # type: ignore - ${1:Reason}"
      ],
      "description": "Add a # type: ignore comment at the end of the current line to suppress a type checker warning, with a reason."
    }
  },
  "LogicControl": {
    "LogicControl.if": {
      "prefix": "if",
      "body": [
        "if ${1:condition}:",
        "\t$2"
      ],
      "description": "Run a block only when a condition is true."
    },
    "LogicControl.else": {
      "prefix": "else",
      "body": [
        "else:",
        "\t$1"
      ],
      "description": "Run a block when the previous if/elif conditions are false."
    },
    "LogicControl.elif": {
      "prefix": "elif",
      "body": [
        "elif ${1:condition}:",
        "\t$2"
      ],
      "description": "Add another condition after an if block."
    },
    "LogicControl.match case": {
      "prefix": "match case",
      "body": [
        "match ${1:variableName}:",
        "\tcase ${2:value}:",
        "\t\traise NotImplementedError('TODO')",
        "\tcase _:",
        "\t\traise NotImplementedError('TODO')"
      ],
      "description": "Use Python structural pattern matching to choose a branch by value or pattern."
    },
    "LogicControl.case": {
      "prefix": "case",
      "body": [
        "case ${1:value}:",
        "\traise NotImplementedError('TODO')"
      ],
      "description": "Add a case branch inside a match block."
    },
    "LogicControl.for-index, item": {
      "prefix": "for",
      "body": [
        "for ${1:idx}, ${2:item} in enumerate(${3:obj},start=${4:0}):",
        "\t$5"
      ],
      "description": "Loop over items with enumerate() and a zero-based or custom starting index."
    },
    "LogicControl.for-item": {
      "prefix": "for",
      "body": [
        "for ${1:item} in ${2:obj}:",
        "\t$3"
      ],
      "description": "Loop over each item in an iterable object."
    },
    "LogicControl.for-counting cycle": {
      "prefix": "for",
      "body": [
        "for ${1:idx} in range(${2:0},${3:intStop},${4:1}):",
        "\t$5"
      ],
      "description": "Loop over a sequence of numbers generated by range()."
    },
    "LogicControl.while": {
      "prefix": "while",
      "body": [
        "while ${1:condition}:",
        "\t$2"
      ],
      "description": "Repeat a block while a condition is true."
    },
    "LogicControl.continue": {
      "prefix": "continue",
      "body": [
        "continue"
      ],
      "description": "Skip the rest of the current loop iteration and continue with the next one."
    },
    "LogicControl.break": {
      "prefix": "break",
      "body": [
        "break"
      ],
      "description": "Exit the nearest loop immediately."
    },
    "LogicControl.try catch": {
      "prefix": "try",
      "body": [
        "try:",
        "\t$1",
        "except Exception as e:",
        "\traise NotImplementedError('TODO')",
        "else:",
        "\traise NotImplementedError('TODO')",
        "finally:",
        "\traise NotImplementedError('TODO')"
      ],
      "description": "Handle exceptions with try/except, and optionally run else/finally blocks."
    },
    "LogicControl.retry": {
      "prefix": "retry",
      "body": [
        "intMaxTryCount = ${1:intMaxTryCount}",
        "for intTryIdx in range(intMaxTryCount):",
        "\ttry:",
        "\t\t$2",
        "\texcept Exception as e:",
        "\t\tLog.exception_info(e)",
        "\t\tif intTryIdx +1 == intMaxTryCount:",
        "\t\t\traise e",
        "\telse:",
        "\t\tbreak"
      ],
      "description": "Retry a block until it succeeds, or raise the last error after the maximum try count is reached."
    },
    "LogicControl.raise an exception": {
      "prefix": "raise",
      "body": [
        "raise ${1:Exception}(${2:\"The description of the error\"})"
      ],
      "description": "Raise an exception with a message."
    },
    "LogicControl.return": {
      "prefix": "return",
      "body": [
        "return ${1:value}"
      ],
      "description": "Return a value from the current function."
    }
  },
  "Log": {
    "Log.verbose": {
      "prefix": "Log.verbose",
      "body": "Log.verbose($1)",
      "description": "Write a log entry at the VERBOSE level, only if the current log level allows it.\n\nParameters:\n    messages: Values to write to the log. Multiple values are converted to strings and joined by sep in the human_read log. In the machine_read log, a single value is stored as-is, and multiple values are stored as a list of original values.\n    sep: Separator inserted between multiple values in the human_read log. It does not change values stored in the machine_read log."
    },
    "Log.verbose_pretty": {
      "prefix": "Log.verbose_pretty",
      "body": "Log.verbose_pretty($1)",
      "description": "Write a formatted log entry at the VERBOSE level, only if the current log level allows it.\n\nDict, list, and tuple values are formatted with indentation in the human_read log only. The machine_read log keeps the original values unchanged.\n\nParameters:\n    messages: Values to write to the log.\n    sep: Separator inserted between multiple values in the human_read log."
    },
    "Log.debug": {
      "prefix": "Log.debug",
      "body": "Log.debug($1)",
      "description": "Write a log entry at the DEBUG level, only if the current log level allows it.\n\nParameters:\n    messages: Values to write to the log. Multiple values are converted to strings and joined by sep in the human_read log. In the machine_read log, a single value is stored as-is, and multiple values are stored as a list of original values.\n    sep: Separator inserted between multiple values in the human_read log. It does not change values stored in the machine_read log."
    },
    "Log.debug_pretty": {
      "prefix": "Log.debug_pretty",
      "body": "Log.debug_pretty($1)",
      "description": "Write a formatted log entry at the DEBUG level, only if the current log level allows it.\n\nDict, list, and tuple values are formatted with indentation in the human_read log only. The machine_read log keeps the original values unchanged.\n\nParameters:\n    messages: Values to write to the log.\n    sep: Separator inserted between multiple values in the human_read log."
    },
    "Log.info": {
      "prefix": "Log.info",
      "body": "Log.info($1)",
      "description": "Write a log entry at the INFO level, only if the current log level allows it.\n\nParameters:\n    messages: Values to write to the log. Multiple values are converted to strings and joined by sep in the human_read log. In the machine_read log, a single value is stored as-is, and multiple values are stored as a list of original values.\n    sep: Separator inserted between multiple values in the human_read log. It does not change values stored in the machine_read log."
    },
    "Log.info_pretty": {
      "prefix": "Log.info_pretty",
      "body": "Log.info_pretty($1)",
      "description": "Write a formatted log entry at the INFO level, only if the current log level allows it.\n\nDict, list, and tuple values are formatted with indentation in the human_read log only. The machine_read log keeps the original values unchanged.\n\nParameters:\n    messages: Values to write to the log.\n    sep: Separator inserted between multiple values in the human_read log."
    },
    "Log.warning": {
      "prefix": "Log.warning",
      "body": "Log.warning($1)",
      "description": "Write a log entry at the WARNING level, only if the current log level allows it.\n\nParameters:\n    messages: Values to write to the log. Multiple values are converted to strings and joined by sep in the human_read log. In the machine_read log, a single value is stored as-is, and multiple values are stored as a list of original values.\n    sep: Separator inserted between multiple values in the human_read log. It does not change values stored in the machine_read log."
    },
    "Log.warning_pretty": {
      "prefix": "Log.warning_pretty",
      "body": "Log.warning_pretty($1)",
      "description": "Write a formatted log entry at the WARNING level, only if the current log level allows it.\n\nDict, list, and tuple values are formatted with indentation in the human_read log only. The machine_read log keeps the original values unchanged.\n\nParameters:\n    messages: Values to write to the log.\n    sep: Separator inserted between multiple values in the human_read log."
    },
    "Log.error": {
      "prefix": "Log.error",
      "body": "Log.error($1)",
      "description": "Write a log entry at the ERROR level, only if the current log level allows it.\n\nParameters:\n    messages: Values to write to the log. Multiple values are converted to strings and joined by sep in the human_read log. In the machine_read log, a single value is stored as-is, and multiple values are stored as a list of original values.\n    sep: Separator inserted between multiple values in the human_read log. It does not change values stored in the machine_read log."
    },
    "Log.error_pretty": {
      "prefix": "Log.error_pretty",
      "body": "Log.error_pretty($1)",
      "description": "Write a formatted log entry at the ERROR level, only if the current log level allows it.\n\nDict, list, and tuple values are formatted with indentation in the human_read log only. The machine_read log keeps the original values unchanged.\n\nParameters:\n    messages: Values to write to the log.\n    sep: Separator inserted between multiple values in the human_read log."
    },
    "Log.critical": {
      "prefix": "Log.critical",
      "body": "Log.critical($1)",
      "description": "Write a log entry at the CRITICAL level, only if the current log level allows it.\n\nParameters:\n    messages: Values to write to the log. Multiple values are converted to strings and joined by sep in the human_read log. In the machine_read log, a single value is stored as-is, and multiple values are stored as a list of original values.\n    sep: Separator inserted between multiple values in the human_read log. It does not change values stored in the machine_read log."
    },
    "Log.critical_pretty": {
      "prefix": "Log.critical_pretty",
      "body": "Log.critical_pretty($1)",
      "description": "Write a formatted log entry at the CRITICAL level, only if the current log level allows it.\n\nDict, list, and tuple values are formatted with indentation in the human_read log only. The machine_read log keeps the original values unchanged.\n\nParameters:\n    messages: Values to write to the log.\n    sep: Separator inserted between multiple values in the human_read log."
    },
    "Log.exception_info": {
      "prefix": "Log.exception_info",
      "body": "Log.exception_info(exObj=$1)",
      "description": "Record the Exception object's 'type', 'message', 'fileName' and 'lineNumber' in a dict format and \"ERROR\" log level, only if the current log level allows it.\n\nParameters:\n    exObj: The Exception object to record."
    },
    "Log.set_level": {
      "prefix": "Log.set_level",
      "body": "Log.set_level(level=${1|'VERBOSE','DEBUG','INFO','WARNING','ERROR','CRITICAL'|}, loggerType=${2|'both','human','machine'|})",
      "description": "Set the minimum log level for the logger.\n\nParameters:\n    level: The minimum level to set. Must be one of ['VERBOSE', 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'].\n    loggerType: Which logger to set the level for. Must be one of ['both', 'human', 'machine']."
    },
    "Log.add_custom_log_part": {
      "prefix": "Log.add_custom_log_part",
      "body": "Log.add_custom_log_part(name=$1, text=$2)",
      "description": "Adds a new part to the log entry format.\n\nIf the name already exists, the text will be updated.\n\nThe name cannot be one of the reserved keywords([\"timestamp\", \"level\", \"message\", \"userName\", \"machineName\", \"processName\", \"fileName\", \"lineNo\", \"projectName\", \"logId\"]) due to they are used in machine_read log.\n\nParameters:\n    name: The new part's name to be added. This will be a new key in the machine_read log entry, but the name won't show in human_read log.\n    text: The text of the new log part, which will be displayed in human_read log."
    },
    "Log.remove_custom_log_part": {
      "prefix": "Log.remove_custom_log_part",
      "body": "Log.remove_custom_log_part(name=$1)",
      "description": "Remove a custom log part by name.\n\nIf the name is not found, no action is taken.\n\nThe name cannot be one of the reserved keywords([\"timestamp\", \"level\", \"message\", \"userName\", \"machineName\", \"processName\", \"fileName\", \"lineNo\", \"projectName\", \"logId\"]) due to they are used in machine_read log.\n\nParameters:\n    name: The name of the custom log part to remove from both the machine_read and human_read logs."
    },
    "Log.trace": {
      "prefix": "Log.trace",
      "body": "@Log.trace(level=${1|'DEBUG','VERBOSE','INFO','WARNING','ERROR','CRITICAL'|})",
      "description": "Decorate a function to log its start and end at a specified log level.\n\nParameters:\n    level: The level to record log. Must be one of ['VERBOSE', 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'].\n\nReturns:\n    Callable[[Callable[P, T]], Callable[P, T]]: A decorator that wraps the target function."
    }
  }
}