// FileName: tasks.json
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE.*v\\d",
          "endsPattern": "Local:.*127\\.0\\.0\\.1:5173"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Frontend: check",
      "type": "npm",
      "script": "check",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
