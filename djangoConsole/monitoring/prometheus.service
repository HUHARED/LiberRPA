# FileName: prometheus.service
# Install the official prometheus binary at /usr/local/bin/prometheus.
# Copy this unit to /etc/systemd/system/liberrpa-prometheus.service.
[Unit]
Description=LiberRPA host metrics storage
After=network.target

[Service]
DynamicUser=yes
StateDirectory=liberrpa-prometheus
ExecStart=/usr/local/bin/prometheus --config.file=/etc/liberrpa-console/monitoring/prometheus.yml --web.listen-address=127.0.0.1:9090 --storage.tsdb.path=/var/lib/liberrpa-prometheus --storage.tsdb.retention.time=15d
Restart=on-failure

[Install]
WantedBy=multi-user.target
