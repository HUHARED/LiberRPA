// FileName: Console.jsonc
{
  // Local development only. Copy to .local/Console.jsonc.
  // Changes take effect after restarting the application.
  "debug": false,
  "allowedHosts": ["localhost", "127.0.0.1", "[::1]"],

  // Application diagnostics use UTC; run_dev.py captures and rotates development output in .local/logs/.
  // Deployment manages process output separately.
  // Request summaries use route names and generated X-Request-ID values, never raw URLs.
  "logging": {
    "level": "INFO",
    "requests": true
  },

  // Relative secret paths are resolved against this configuration file.
  // Store UTF-8 text in these files; never put the secret values here.
  "secretKeyFile": "secrets/django-secret-key.txt",
  // The first key encrypts new secrets; remaining keys can decrypt existing values.
  // NOTE: Back up these files separately and retain keys required by stored values or supported backups.
  // Missing configured files are errors; keys are never generated during startup.
  "encryptionKeyFiles": ["secrets/encryption-key.txt"],
  // Relative to this configuration file; all application and cleanup workers must share this volume.
  // Never serve this directory directly through the web server.
  "storageRoot": "storage",
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "name": "liberrpa_console",
    "user": "liberrpa_console",
    "passwordFile": "secrets/database-password.txt"
  },

  // HAProxy Runtime API for download-slot cleanup; never expose this port publicly.
  // For proxy testing or deployment, use { "host": "127.0.0.1", "port": 9999 }.
  // null permits direct local development only, with a loopback consoleUrl.
  // Global upload/download bandwidth is configured in haproxy.cfg.
  "fileTransferProxy": null,

  // Required email settings. Replace the example addresses and SMTP host.
  // consoleUrl is the browser-facing site root, not the internal listening address.
  // Use HTTPS; HTTP is accepted only for localhost, 127.0.0.1, or [::1].
  "consoleUrl": "http://127.0.0.1:5173",
  "supportEmail": "support@example.com",
  "smtp": {
    "host": "smtp.example.com",
    "port": 465,
    "security": "ssl", // "ssl" for implicit TLS, or "starttls" for STARTTLS.
    "user": "notifications@example.com",
    "passwordFile": "secrets/smtp-password.txt",
    "fromEmail": "notifications@example.com",
    "fromName": "LiberRPA Console",
    "timeoutSeconds": 10
  },

  // Optional deployment limits. Omitted values use defaults.
  // Byte limits use binary units: 1 KiB = 1024 bytes, 1 MiB = 1048576 bytes, 1 GiB = 1073741824 bytes.
  "limits": {
    // Run "python backend/manage.py prune_audit_records" regularly in deployment.
    // Both age and count apply; organization deletion also removes its tenant audit.
    "auditRetentionDays": 180,
    "maxAuditRecordsPerOrganization": 100000,
    "maxPlatformAuditRecords": 100000,

    // Organization capacity.
    // Existing members and unexpired pending invitations count toward this limit.
    // Administrators and inactive members also count.
    // A value of 0 blocks invitations; lowering the limit does not remove existing members.
    "maxMembersPerOrganization": 50,

    // Deleted departments do not count. A value of 0 blocks new departments.
    "maxDepartmentsPerOrganization": 20,
    // Top-level departments have depth 1.
    "maxDepartmentDepth": 5,

    // Current Executor records count, including paused and unassociated records.
    // A value of 0 blocks creation; lowering the limit preserves existing records.
    "maxExecutorsPerOrganization": 20,

    // Current Executor groups count, including empty groups; deleted groups do not count.
    // A value of 0 blocks creation; lowering the limit preserves existing groups and members.
    "maxExecutorGroupsPerOrganization": 50,

    // Projects are grouped by department and project name among uploaded packages.
    "maxProjectsPerOrganization": 100,
    // Per project within one department; each package has a distinct version.
    "maxPackagesPerProject": 20,
    "maxPackageBytes": 536870912, // 512 MiB
    "maxSchedulesPerOrganization": 200,
    "maxActiveJobsPerOrganization": 500,
    "newJobsPerMinute": 60,
    "newJobsBurst": 120,
    // Only completed or administratively closed Jobs are eligible for grouped cleanup.
    "runHistoryRetentionDays": 720,
    "maxRunHistoryPerOrganization": 20000,
    "runLogRetentionDays": 720,
    "maxRunLogBytesPerOrganization": 5368709120, // 5 GiB
    "maxRunLogGroupsPerOrganization": 10000,
    // Non-member addresses only; current member emails are available automatically.
    "maxRunEmailAddressesPerOrganization": 100,
    "maxRunEmailRecipientsPerOrganizationHour": 100,
    "maxRunEmailRecipientsPerOrganizationDay": 500,
    "maxRunEmailRecipientsPerAddressHour": 30,
    "maxRunEmailRecipientsPer24Hours": 2000,
    "maxNotificationsPerAccount": 200,
    "notificationRetentionDays": 30,

    // Ordinary and secret assets share the count limit; 0 blocks creation.
    "maxAssetsPerOrganization": 1000,
    // UTF-8 bytes: text content or compact JSON; a Credential counts both fields together.
    "maxAssetValueBytes": 65536, // 64 KiB
    "maxSecretAssetValueBytes": 16384, // 16 KiB

    // Queue capacity counts both statuses. Existing business data is never auto-deleted.
    "maxDataQueuesPerOrganization": 50,
    "maxQueueItemsPerOrganization": 20000,
    "maxQueueDataBytesPerOrganization": 104857600, // 100 MiB
    "maxQueueItemBytes": 1048576, // 1 MiB
    // Receipts are pruned on new queue mutations after at least 30 days.
    // A full receipt budget blocks new mutations instead of evicting unexpired receipts.
    "queueReceiptRetentionDays": 30,
    "maxQueueReceiptsPerOrganization": 100000,

    // Packages and shared files share this organization storage pool.
    // Garbage remains charged until cleanup succeeds; overwrites reserve the full new size.
    "maxStoredBytesPerOrganization": 5368709120, // 5 GiB
    // Counts current shared files; overwriting an existing file does not increase the count.
    // 0 blocks new filenames but permits replacing existing files.
    "maxSharedFilesPerOrganization": 5000,
    "maxSharedFileBytes": 20971520, // 20 MiB
    "minStorageFreeBytes": 5368709120, // 5 GiB
    // Separate organization-wide limits; 0 blocks new transfers in that direction.
    // Downloads include packages, shared files, Run logs, videos and subtitles.
    // Relaying one Run file counts as one download, not an additional upload.
    "maxActiveUploadsPerOrganization": 4,
    "maxActiveDownloadsPerOrganization": 4,
    "fileReceiptRetentionDays": 30,
    "maxFileReceiptsPerOrganization": 100000,
    // Run "python backend/manage.py cleanup_file_storage" at least once per minute.

    // API key capacity and inactive metadata retention per account.
    // Expired and revoked keys do not consume active capacity; 0 blocks new keys.
    "maxActiveApiKeysPerAccount": 10,
    // Retain inactive records within both limits; editing Notes never extends retention.
    // A value of 0 disables inactive metadata retention.
    "inactiveApiKeyRetentionDays": 30,
    "maxInactiveApiKeysPerAccount": 100,

    // Run "python backend/manage.py prune_email_deliveries" regularly in deployment.
    // Completed history is limited separately for each organization and mail without an organization.
    // Pending, sending, recent budget/cooldown records, and today's outcomes remain protected.
    "emailDeliveryRetentionDays": 30,
    "maxEmailDeliveriesPerOrganization": 10000,
    "maxEmailDeliveriesWithoutOrganization": 10000,

    // SMTP delivery budget and rate.
    // All SMTP attempts count toward this rolling budget, including failed attempts.
    // A budget of 0 prevents new attempts.
    "maxEmailRecipientsPer24Hours": 2500,
    // Maximum accumulated recipient units for bursts.
    "emailBurstRecipients": 100,
    // Seconds needed to restore one recipient unit.
    "emailRefillSeconds": 30,

    // Resend cooldown shared by account email flows.
    // Resend cooldown: per address for registration/recovery, per organization and address for invitations, and per account for email changes.
    // Set this interval between 300 and 86400 seconds.
    "emailResendSeconds": 300,

    // Login attempts.
    // All login attempts count, including successful attempts and unknown accounts.
    // Both the source IP and normalized email must have remaining requests; 0 blocks login.
    "loginRequestsPerSource": 30,
    "loginRequestsPerAccount": 10,
    // Fixed windows recover automatically; login failures do not disable an account.
    "loginRequestWindowSeconds": 600,

    // Bearer authentication attempts share one source-IP allowance across all keys.
    // Successful, malformed, and unknown credentials count; 0 blocks Bearer requests.
    // This source guard is separate from organization business budgets and interactive login.
    "apiKeyRequestsPerSource": 2400,
    "apiKeyRequestWindowSeconds": 60,

    // Editor and Executor contact requests each have an independent source-IP allowance using these limits.
    // Canceling a selection or signing out does not consume this allowance.
    // Password login shares the login counters above with web login.
    "nativeClientRequestsPerSource": 2400,
    "nativeClientRequestWindowSeconds": 60,
    // Executors are asked to contact every 15 seconds; Offline never releases a valid association.
    "executorOfflineSeconds": 60,

    // Public registration and password-recovery email requests count separately, including suppressed requests.
    // A value of 0 blocks both flows; fixed windows start with the first attempt.
    "publicEmailRequestsPerSource": 10,
    "publicEmailRequestWindowSeconds": 600,

    // Sensitive actions share settings; each flow keeps separate counters.
    // Applies to invitations, email/password changes, signing out other sessions, API key creation, account deletion, and organization deletion scheduling.
    // Both the source IP and acting account must have allowance; failed password checks also count.
    // Account deletion targets share the actor's allowance within that flow; 0 blocks all listed actions.
    // Each counter's fixed window starts with its first request and lasts at most one day.
    // Status checks and cancellation of organization deletion do not consume this allowance.
    // API key revocation and Notes editing do not consume this allowance.
    "sensitiveActionRequestsPerSource": 30,
    "sensitiveActionRequestsPerAccount": 10,
    "sensitiveActionRequestWindowSeconds": 600,

    // Email-link checks and submissions use shared settings and count per flow.
    // Registration/invitation share one flow; password reset and email change each have their own.
    // Both the source IP and token must have allowance; 0 blocks requests.
    "emailTokenRequestsPerSource": 30,
    "emailTokenRequestsPerToken": 10,
    "emailTokenRequestWindowSeconds": 600
  }
}
