// FileName: Console.jsonc
{
  // Local development only. Copy to .local/Console.jsonc.
  // Changes take effect after restarting the application.
  "debug": false,
  "allowedHosts": ["localhost", "127.0.0.1", "[::1]"],

  // Relative secret paths are resolved against this configuration file.
  // Store UTF-8 text in these files; never put the secret values here.
  "secretKeyFile": "secrets/django-secret-key.txt",
  "database": {
    "host": "127.0.0.1",
    "port": 5432,
    "name": "liberrpa_console",
    "user": "liberrpa_console",
    "passwordFile": "secrets/database-password.txt"
  },

  // Configure these three fields together before using email.
  // null keeps email unavailable during backend development.
  // consoleUrl is the browser-facing site root, not the internal listening address.
  // Use HTTPS; HTTP is accepted only for localhost, 127.0.0.1, or [::1].
  "consoleUrl": null,
  "supportEmail": null,
  "smtp": null,

  // Example values for the fields above; replace the addresses and SMTP host.
  // "consoleUrl": "https://console.example.com/",
  // "supportEmail": "support@example.com",
  // "smtp": {
  //     "host": "smtp.example.com",
  //     "port": 465,
  //     "security": "ssl", // "ssl" for implicit TLS, or "starttls" for STARTTLS.
  //     "user": "notifications@example.com",
  //     "passwordFile": "secrets/smtp-password.txt",
  //     "fromEmail": "notifications@example.com",
  //     "fromName": "LiberRPA Console",
  //     "timeoutSeconds": 10
  // },

  // Optional deployment limits. Omitted values use defaults.
  "limits": {
    // Existing members and unexpired pending invitations count toward this limit.
    // Administrators and inactive members also count.
    // A value of 0 blocks invitations; lowering the limit does not remove existing members.
    "maxMembersPerOrganization": 50,

    // Deleted departments do not count. A value of 0 blocks new departments.
    "maxDepartmentsPerOrganization": 20,
    // Top-level departments have depth 1.
    "maxDepartmentDepth": 5,

    // All SMTP attempts count toward this rolling budget, including failed attempts.
    // A budget of 0 prevents new attempts.
    "maxEmailRecipientsPer24Hours": 2500,
    // Maximum accumulated recipient units for bursts.
    "emailBurstRecipients": 100,
    // Seconds needed to restore one recipient unit.
    "emailRefillSeconds": 30,

    // Registration email API requests per source IP in a fixed window.
    // A value of 0 blocks requests; the recipient's resend cooldown still applies.
    "registrationEmailRequestsPerSource": 10,
    // The window starts with the source's first request and lasts at most one day.
    "registrationEmailRequestWindowSeconds": 600,

    // Invitation requests for the same address in one organization must wait this long.
    // Set this interval between 300 and 86400 seconds.
    "invitationResendSeconds": 300,
    // Requests to create or resend invitations share these limits.
    // Both the source IP and requesting administrator must have allowance; 0 blocks requests.
    "invitationEmailRequestsPerSource": 30,
    "invitationEmailRequestsPerAccount": 10,
    // Each counter's fixed window starts with its first request and lasts at most one day.
    "invitationEmailRequestWindowSeconds": 600,

    // Reading registration or invitation links and submitting either form share these limits.
    // Both the source IP and the token must have remaining requests; 0 blocks requests.
    "registrationTokenRequestsPerSource": 30,
    "registrationTokenRequestsPerToken": 10,
    // Each counter's fixed window starts with its first request and lasts at most one day.
    "registrationTokenRequestWindowSeconds": 600,

    // All login attempts count, including successful attempts and unknown accounts.
    // Both the source IP and normalized email must have remaining requests; 0 blocks login.
    "loginRequestsPerSource": 30,
    "loginRequestsPerAccount": 10,
    // Fixed windows recover automatically; login failures do not disable an account.
    "loginRequestWindowSeconds": 600,

    // Password-change attempts have separate limits from login, including failed submissions.
    // Both the source IP and authenticated account must have allowance; 0 blocks changes.
    "passwordChangeRequestsPerSource": 30,
    "passwordChangeRequestsPerAccount": 10,
    // Each counter's fixed window starts with its first request and lasts at most one day.
    "passwordChangeRequestWindowSeconds": 600,

    // Signing out other sessions has separate limits, including failed password checks.
    // Both the source IP and authenticated account must have allowance; 0 blocks requests.
    "sessionRevocationRequestsPerSource": 30,
    "sessionRevocationRequestsPerAccount": 10,
    // Each counter's fixed window starts with its first request and lasts at most one day.
    "sessionRevocationRequestWindowSeconds": 600,

    // Password recovery uses separate source-IP limits and a per-recipient resend interval.
    // Suppressed requests receive the same public response; resend must wait at least 5 minutes.
    "passwordResetResendSeconds": 300,
    "passwordResetEmailRequestsPerSource": 10,
    "passwordResetEmailRequestWindowSeconds": 600,
    // Link checks and reset submissions share these limits; 0 blocks requests.
    "passwordResetTokenRequestsPerSource": 30,
    "passwordResetTokenRequestsPerToken": 10,
    "passwordResetTokenRequestWindowSeconds": 600,

    // Email-change requests require the current password and have independent limits.
    // Resend cooldown applies to the same account even when the target address changes.
    "emailChangeResendSeconds": 300,
    "emailChangeEmailRequestsPerSource": 30,
    "emailChangeEmailRequestsPerAccount": 10,
    "emailChangeEmailRequestWindowSeconds": 600,
    // Link checks and confirmation share these limits; 0 blocks requests.
    "emailChangeTokenRequestsPerSource": 30,
    "emailChangeTokenRequestsPerToken": 10,
    "emailChangeTokenRequestWindowSeconds": 600
  }
}
