{
  "name": "ui-analyzer",
  "version": "0.3.0",
  "description": "UI Analyzer is an Electron-based client designed to quickly selecting UI elements and build the corresponding selectors (formatted as several specific dictionary) required for RPA operations.",
  "main": "./out/main/index.js",
  "author": "Jiyan Hu",
  "homepage": "https://github.com/HUHARED/LiberRPA/blob/main/electronApplications/ui-analyzer/README.md",
  "scripts": {
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "moment": "^2.30.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@mdi/font": "^7.4.47",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-vue": "^10.10.0",
    "lodash": "^4.18.1",
    "pinia": "^4.0.3",
    "socket.io-client": "^4.8.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "vuetify": "^3.13.1"
  }
}
